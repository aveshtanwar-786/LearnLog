@model List<BloggingWebApp.Models.Domain.Tag>

<div class="bg-secondary bg-opacity-10 py-2">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <h1>All Tags (Admin Only)</h1>
            <div class="justify-content-end">
            <a asp-controller="Home"
               asp-action="Index"
                   class="btn btn-outline-primary">
                Go Home
            </a>
            <a asp-controller="AdminTags"
               asp-action="Add"
               class="btn btn-dark">
                Create New
            </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <table class="table table-success table-striped-columns">

        @if (Model != null && Model.Any())
        {
            <thead>
                <tr>
                    <th scope="col">Identity</th>
                    <th scope="col">Name</th>
                    <th scope="col">Display Name</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tag in Model)
                {
                    <tr>
                        <td>@tag.Id</td>
                        <td>@tag.Name</td>
                        <td>@tag.DispalyName</td>
                        <td>
                            <a asp-area="" asp-controller="AdminTags" asp-action="Edit"
                               asp-route-id="@tag.Id" class="btn btn-outline-dark">Edit</a>
                        </td>
                        
                    </tr>
                }
            </tbody>
        }
        else
        {
            <p>No tags Were Found!</p>
        }

    </table>
    </div>