@model BloggingWebApp.Models.ViewModels.AddTagReq


<div class="bg-secondary bg-opacity-10 py-2">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
        <h1>Add New Tag (Admin Only)</h1>
        </div>
    </div>
</div>
    <div class="container">
    <form method="post">
        <div class="row mb-3">
                <div class="col-sm-10">
                <label class="col-sm-2 col-form-label" asp-for="Name">Name :</label>
                    <input type="text" class="form-control" id="name" asp-for="Name">
            </div>
            </div>
        <div class="row mb-3">
                <div class="col-sm-10">
                <label class="col-sm-2 col-form-label" asp-for="DispalyName">Display Name :</label>
                    <input type="text" class="form-control" id="displayname" asp-for="DispalyName">
            </div>
            </div>
            <button type="submit" class="btn btn-dark">Save</button>
        <a class="btn btn-info ms-2" asp-area="" asp-controller="AdminTags" asp-action="List">Go Back</a>
        </form>
    </div>
