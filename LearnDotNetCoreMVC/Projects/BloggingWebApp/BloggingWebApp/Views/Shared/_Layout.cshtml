<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BloggingWebApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BloggingWebApp.styles.css" asp-append-version="true" />

    <link href='https://cdn.jsdelivr.net/npm/froala-editor@latest/css/froala_editor.pkgd.min.css' rel='stylesheet' type='text/css' />
    <script type='text/javascript' src='https://cdn.jsdelivr.net/npm/froala-editor@latest/js/froala_editor.pkgd.min.js'></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
            <div class="container">
                <a class="navbar-brand fw-bold fs-3 d-flex align-items-center gap-2 pb-1 border-bottom border-primary border-3" asp-controller="Home" asp-action="Index">
                    <span class="text-primary">Zone<span class="text-white">Blue</span></span>
                </a>

                <button class="navbar-toggler border-white" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-2">

                        <li class="nav-item">
                            <a class="nav-link fw-semibold text-white fs-5 px-3 py-2 rounded-3"
                               asp-controller="Home" asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fw-semibold text-white fs-5 px-3 py-2 rounded-3" id="navbarDropdown" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Admin
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow border-0 rounded-3 mt-2"
                                aria-labelledby="navbarDropdown">
                                <li>
                                    <a class="dropdown-item py-2 fw-medium"
                                       asp-controller="AdminTags" asp-action="Add">
                                        Add Tag
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 fw-medium"
                                       asp-controller="AdminTags" asp-action="List">
                                        Show All Tags
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider bg-white opacity-25"></li>
                                <li>
                                    <a class="dropdown-item py-2 fw-medium"
                                       asp-controller="AdminBlogPost" asp-action="Add">
                                        Add Blog Post
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 fw-medium"
                                       asp-controller="AdminBlogPost" asp-action="List">
                                        Show All Blog Posts
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-semibold text-white fs-5 px-3 py-2 rounded-3"
                               asp-controller="Location" asp-action="Index">
                                Cascading Dropdown
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    @RenderBody()

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - BloggingWebApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
