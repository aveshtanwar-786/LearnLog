@model List<Student>
@{
    ViewData["Title"] = "Index";
    // Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="bg-primary">Index Page</h1>
@* <h1 class="bg-info">Index</h1>
<h1 class="bg-danger">Index</h1> *@

@{
    foreach (var Stud in Model)
    {
        <p>@Stud.Id</p>
        <p>@Stud.Name</p>
        <p>@Stud.Gender</p>
    }
}

