<div class="content-body">
    <div class="container pd-x-0">
        <div class="d-sm-flex align-items-center justify-content-between mg-b-20">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-style1 mg-b-10">
                        <li class="breadcrumb-item"><a asp-action="Index">States</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Edit</li>
                    </ol>
                </nav>
                <h4 class="mg-b-0 tx-spacing--1">Edit State</h4>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-6 col-xl-5">
                <div class="card">
                    <div class="card-header pd-y-20 bd-b-0">
                        <h6 class="mg-b-0">Update Information</h6>
                    </div>
                    <div class="card-body pd-30">
                        <form asp-action="Edit">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <input type="hidden" asp-for="StateId" />

                            <div class="form-group">
                                <label asp-for="StateCode" class="tx-10 tx-uppercase tx-medium tx-spacing-1 mg-b-5">State Code</label>
                                <input asp-for="StateCode" class="form-control" />
                                <span asp-validation-for="StateCode" class="tx-12 text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="StateName" class="tx-10 tx-uppercase tx-medium tx-spacing-1 mg-b-5">State Name</label>
                                <input asp-for="StateName" class="form-control" />
                                <span asp-validation-for="StateName" class="tx-12 text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="CreatedOn" class="tx-10 tx-uppercase tx-medium tx-spacing-1 mg-b-5">Created On</label>
                                @* <input asp-for="CreatedOn" class="form-control" />
                                <span asp-validation-for="CreatedOn" class="tx-12 text-danger"></span> *@
                                <dl class="row mb-0">
                                    @* <dt class="col-sm-4 tx-medium tx-color-03">@Html.DisplayNameFor(model => model.CreatedOn)</dt> *@
                                    <dd class="col-sm-8 tx-color-01">@Html.DisplayFor(model => model.CreatedOn)</dd>
                                </dl>
                            </div>

                            <div class="form-group">
                                <div class="custom-control custom-checkbox">
                                    <input type="checkbox" class="custom-control-input" asp-for="Status" />
                                    <label class="custom-control-label" asp-for="Status">@Html.DisplayNameFor(model => model.Status)</label>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end mg-t-30">
                                <a asp-action="Index" class="btn btn-white mg-r-10">Cancel</a>
                                <button type="submit" class="btn btn-primary">Save Changes</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
