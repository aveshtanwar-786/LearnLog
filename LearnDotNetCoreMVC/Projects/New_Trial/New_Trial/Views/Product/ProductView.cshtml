@{
    ViewData["Title"] = "Product";
    var mProducts = ViewBag.Product1;
}
@section Scripts{
   
}
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
</head>
 <div class="content-body">
     <div class="container-fluid">
         <div class="card">
             <div class="card-header">
                <div class="d-flex align-items-center justify-content-between flex-wrap">
                    <h4 class="mb-0">
                        <i class="far fa-list-alt text-primary"></i> View: Product
                    </h4>
                    <div class="mt-2 mt-md-0">
                        <button onclick="window.location.href='@Url.Action("New", "Product")'" class="btn btn-primary btn-sm me-2">
                            <i class="fas fa-plus"></i> Add New
                        </button>
                        <button onclick="" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-rotate"></i> Refresh
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <table class="table table-hover table-bordered table-striped">
                    <thead class="table-primary">
                        <tr class="text-center">
                            <th>Sr No.</th>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Price(Rs.)</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            foreach (var Prod in mProducts)
                            {
                             <tr class="text-center">
                                    <td>@Prod.SrNo</td>
                                    <td>@Prod.ProdCode</td>
                                    <td>@Prod.ProdName</td>
                                    <td>@Prod.ProdPrice</td>
                                    <td>@Prod.ProdtDescription</td>
                            </tr>
                            }
                        }

                        
                        @*public int SrNo { get; set; }
        public string ProdCode { get; set; }
        public string ProdName { get; set; }
        public int ProdPrice { get; set; }
        public string ProdtDescription { get; set; } *@
                    </tbody>
                </table>
            </div>
        </div> 
    </div> 
</div>
