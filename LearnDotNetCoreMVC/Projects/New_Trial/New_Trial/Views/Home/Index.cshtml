 @{
    ViewData["Title"] = "Home Page";
}
<div class="container mt-4">

    
    <div class="mb-4">
        @* <h7 class="display-6">𝓡𝓮𝓬𝓸𝓶𝓶𝓮𝓷𝓭𝓪𝓽𝓲𝓸𝓷𝓼</h7> *@
        <h3 style="font-family:'Great Vibes', cursive; letter-spacing:0.6px;">
            Recommendations : 
        </h3>


    </div>

  
    <div id="productCarousel" class="carousel slide mb-5" data-bs-ride="carousel" data-bs-interval="5000">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="/images/product1.jpg" class="carousel-img" alt="Product 1">
            </div>
             <div class="carousel-item">
                <img src="/images/product2.jpg" class="carousel-img" alt="Product 2">
            </div>
            <div class="carousel-item">
                <img src="/images/product3.jpg" class="carousel-img" alt="Product 3">
            </div> 
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
        </button>
    </div>

    <!-- 🛒 Product Grid -->
    <div class="row row-cols-1 row-cols-md-3 g-4">
        <div class="col">
            <div class="card h-100">
                <img src="/images/product1.jpg" class="card-img-top" alt="Product 1">
                <div class="card-body">
                    <h5 class="card-title">Red T-Shirt</h5>
                    <p class="card-text">Men's Cotton T-Shirt,Medium-Red Colour</p>
                    <p class="text-success fw-bold">Rs.499</p>
                    <a href="#" class="btn btn-warning">Buy Now</a>
                </div>
            </div>
        </div>

        <!-- Repeat for other products -->
        <div class="col">
            <div class="card h-100">
                <img src="/images/product2.jpg" class="card-img-top" alt="Product 2">
                <div class="card-body">
                    <h5 class="card-title">Maggi(Pack of 1)</h5>
                    <p class="card-text">Nestle Maggi 45g</p>
                    <p class="text-success fw-bold">Rs.20</p>
                    <a href="#" class="btn btn-warning">Buy Now</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100">
                <img src="/images/product3.jpg" class="card-img-top" alt="Product 3">
                <div class="card-body">
                    <h5 class="card-title">Cricket Bat-KOOKABURRA</h5>
                    <p class="card-text">Cricket Bat-Kookaburra, English Willow 500gm English Wood</p>
                    <p class="text-success fw-bold">Rs.1499</p>
                    <a href="#" class="btn btn-warning">Buy Now</a>
                </div>
            </div>
        </div>
    </div>
</div> 




