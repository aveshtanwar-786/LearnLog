<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <div class="sidebar" id="sidebar">
        <button class="toggle-btn" id="toggleBtn">☰</button>
        <div class="sidebar-title">
            <h2>Menu</h2>
        </div>
        <div class="menu-items">
            <a asp-controller="Product" asp-action="Index"><i class="fas fa-box"></i> <span class="link-text">Products</span></a>
            <a asp-controller="Category" asp-action="Index"><i class="fas fa-tags"></i> <span class="link-text">Categories</span></a>
            <a asp-controller="Supplier" asp-action="Index"><i class="fas fa-truck"></i> <span class="link-text">Suppliers</span></a>
            <a asp-controller="Customer" asp-action="Index"><i class="fas fa-users"></i> <span class="link-text">Customers</span></a>
            <a asp-controller="Order" asp-action="Index"><i class="fas fa-shopping-cart"></i> <span class="link-text">Orders</span></a>
        </div>

    </div>

    <div class="main-content" id="mainContent">
        <div class="top-bar">
            <div>
                @* <h2>𝙑𝘿𝙠𝙖𝙧𝙩</h2> *@
                <img src="/images/logo4.png" alt="VDkart Logo" class="logo">
            </div>
        </div>

        <div class="page-body">
            @RenderBody()
            @RenderSection("Scripts", required: false)
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        body {
            padding: 0;
            margin: 0;
            font-family: 'Segoe UI';
        }

        .sidebar-title {
            color: white;
            padding: 10px 20px;
            opacity: 0;
            transition: opacity 0.3s;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sidebar:hover .sidebar-title {
            opacity: 1;
        }


        .sidebar {
            height: 100vh;
            background-color: navy;
            width: 60px;
            transition: width 0.3s;
            overflow-x: hidden;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
        }

            .sidebar:hover {
                width: 200px;
            }

        .toggle-btn {
            background: none;
            border: none;
            color: white;
            font-size: 24px;
            width: 100%;
            padding: 15px;
            text-align: left;
            cursor: pointer;
            outline: none;
        }

        .menu-items {
            margin-top: 20px;
        }

        .sidebar a {
            color: white;
            display: flex;
            align-items: center;
            padding: 15px 20px;
            text-decoration: none;
            transition: transform 0.3s;
        }

        .sidebar:hover a {
            opacity: 1;
        }

        .sidebar a i {
            width: 20px;
            min-width: 20px;
            text-align: center;
            margin-right: 10px;
            color: white;
            flex-shrink: 0;
        }

        .link-text {
            display: none;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Hide text labels when sidebar is collapsed */
        .sidebar .link-text {
            display: none;
        }

        /* Show text labels when sidebar is expanded */
        .sidebar:hover .link-text {
            display: inline;
        }


        .sidebar a:hover {
            background-color: #001f4d;
            transform: translateX(5px);
        }

        .main-content {
            margin-left: 60px;
            padding: 20px;
            transition: margin-left 0.3s;
        }

        .sidebar:hover ~ .main-content {
            margin-left: 200px;
        }

        .carousel-img {
            max-height: 600px; /* Limit height */
            width: auto; /* Keep natural width */
            object-fit: contain; /* Show full image without cropping */
            margin: 0 auto; /* Center the image horizontally */
            display: block;
        }

        .carousel-item {
            text-align: center; /* Center images in the carousel */
        }

        }
    </style>
</body>
